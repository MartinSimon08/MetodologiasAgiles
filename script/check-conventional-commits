#!/usr/bin/env bash
# Valida titulos de PR y mensajes de commit contra Conventional Commits.
# Uso:
#   script/check-conventional-commits --title "feat: agregar cliente"
#   script/check-conventional-commits --from origin/main --to HEAD
#   script/check-conventional-commits --title "feat: agregar cliente" --from SHA --to SHA
set -euo pipefail

TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
HEADER_REGEX="^(${TYPES})(\([a-z0-9._/-]+\))?(!)?: [^[:space:]].+$"
MAX_LEN=100

usage() {
  cat <<'EOF'
Uso:
  script/check-conventional-commits --title "feat: descripcion"
  script/check-conventional-commits --from <sha> --to <sha>
  script/check-conventional-commits --title "feat: descripcion" --from <sha> --to <sha>
EOF
}

title=""
title_provided=0
from_ref=""
to_ref=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      if [[ $# -lt 2 ]]; then
        echo "--title requiere un valor." >&2
        exit 2
      fi
      title="$2"
      title_provided=1
      shift 2
      ;;
    --from)
      if [[ $# -lt 2 ]]; then
        echo "--from requiere un valor." >&2
        exit 2
      fi
      from_ref="$2"
      shift 2
      ;;
    --to)
      if [[ $# -lt 2 ]]; then
        echo "--to requiere un valor." >&2
        exit 2
      fi
      to_ref="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Argumento desconocido: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if (( title_provided == 0 )) && [[ -z "$from_ref" && -z "$to_ref" ]]; then
  usage >&2
  exit 2
fi

if [[ -n "$from_ref" && -z "$to_ref" ]] || [[ -z "$from_ref" && -n "$to_ref" ]]; then
  echo "Hay que pasar --from y --to juntos." >&2
  exit 2
fi

is_merge_subject() {
  local subject="$1"
  [[ "$subject" =~ ^Merge[[:space:]] ]]
}

validate_subject() {
  local subject="$1"
  local label="$2"
  local allow_merge="${3:-}"
  local failed=0

  subject="${subject%$'\r'}"

  if [[ "$allow_merge" == "allow-merge" ]] && is_merge_subject "$subject"; then
    return 0
  fi

  if [[ -z "$subject" ]]; then
    echo "ERROR: ${label} esta vacio."
    return 1
  fi

  if (( ${#subject} > MAX_LEN )); then
    echo "ERROR: ${label} supera ${MAX_LEN} caracteres (${#subject}):"
    echo "  ${subject}"
    failed=1
  fi

  if [[ "$subject" == *. ]]; then
    echo "ERROR: ${label} no debe terminar en punto:"
    echo "  ${subject}"
    failed=1
  fi

  if [[ ! "$subject" =~ $HEADER_REGEX ]]; then
    echo "ERROR: ${label} no sigue Conventional Commits:"
    echo "  ${subject}"
    echo "  Formato: <type>(<scope>)!: <description>"
    echo "  Tipos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    failed=1
  fi

  return "$failed"
}

errors=0

if (( title_provided == 1 )); then
  if ! validate_subject "$title" "titulo del PR"; then
    errors=$((errors + 1))
  fi
fi

if [[ -n "$from_ref" ]]; then
  while IFS= read -r subject; do
    if [[ -z "$subject" ]]; then
      continue
    fi
    if ! validate_subject "$subject" "commit" allow-merge; then
      errors=$((errors + 1))
    fi
  done < <(git log --format=%s "${from_ref}..${to_ref}")
fi

if (( errors > 0 )); then
  echo
  echo "Fallaron ${errors} mensaje(s). Ver Conventional Commits: https://www.conventionalcommits.org/"
  exit 1
fi

echo "OK: titulos y commits siguen Conventional Commits."
